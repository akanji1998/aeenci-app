{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev (mocks)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": ["--flavor", "dev"]
    },
    {
      "name": "dev (API locale, émulateur Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": [
        "--flavor", "dev",
        "--dart-define=USE_MOCKS=false",
        "--dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1"
      ]
    },
    {
      "name": "prod",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "args": [
        "--flavor", "prod",
        "--dart-define=API_BASE_URL=https://api.aeenci.com/api/v1"
      ]
    }
  ]
}
