	<key>API_KEY</key>
	<string>CHANGE_ME</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>BUNDLE_ID</key>
	<string>com.aeenci.app</string>
	<key>PROJECT_ID</key>
	<string>aeenci-CHANGE_ME</string>
	<key>GOOGLE_APP_ID</key>
